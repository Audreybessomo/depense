# ---------------------------------------------------------------------------
# Base de donnees
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_finances?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
APP_NAME="Gestion des Finances"
# Genere avec: openssl rand -base64 48
AUTH_SECRET="change-moi-absolument-en-production-48-caracteres-minimum"
SESSION_TTL_DAYS="7"

# ---------------------------------------------------------------------------
# Stockage des fichiers : "local" | "s3"
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# Si STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Emails : "console" | "smtp"
# ---------------------------------------------------------------------------
MAIL_DRIVER="console"
MAIL_FROM="Gestion des Finances <no-reply@exemple.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# Metier
# ---------------------------------------------------------------------------
BASE_CURRENCY="XAF"
MAX_UPLOAD_MB="20"
